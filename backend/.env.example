# Copy to .env and fill in. NEVER commit the real .env.

# ----- general --------------------------------------------------------------
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false

# ----- security -------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required in staging/production; auto-generated per-process if left blank locally.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- database -------------------------------------------------------------
# Inside docker-compose use POSTGRES_HOST=db ; running natively use localhost.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sih26122
# Optional single-URL override (wins over the parts above):
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
DB_ECHO=false

# ----- redis / background jobs ----------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ----- cors -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ----- storage --------------------------------------------------------------
UPLOAD_DIR=uploads
GENERATED_REPORTS_DIR=generated_reports
MAX_UPLOAD_SIZE_MB=50

# ----- pluggable providers --------------------------------------------------
# LLM is OPTIONAL. With no key configured the platform uses the deterministic
# rule-based extractor and says so in every matching-run response. Nothing
# fabricates output when the LLM is absent.
#   LLM_PROVIDER: none | anthropic | openai
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30

# EMBEDDING_PROVIDER: tfidf | sentence_transformer
#   tfidf               lexical, default, no model download, no torch
#   sentence_transformer true semantic embeddings; needs
#                        `pip install sentence-transformers` (adds ~1-2 GB).
#                        Falls back to tfidf automatically if not installed.
EMBEDDING_PROVIDER=tfidf
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

OCR_PROVIDER=noop

# ----- matching thresholds --------------------------------------------------
# At or above AUTO -> linked automatically. At or above REVIEW -> queued for a
# human. Below -> recorded as unmatched. Tune to how much review you can absorb.
MATCH_AUTO_THRESHOLD=0.82
MATCH_REVIEW_THRESHOLD=0.55
MATCH_MAX_CANDIDATES=5
MATCH_BLOCKING_LIMIT=400

# Relative signal weights, normalised at use.
MATCH_WEIGHT_EXACT_CODE=1.00
MATCH_WEIGHT_FUZZY=0.80
MATCH_WEIGHT_EMBEDDING=0.70
MATCH_WEIGHT_LOCATION=0.60
MATCH_WEIGHT_KEYWORD=0.55
MATCH_WEIGHT_DISCIPLINE=0.35
MATCH_WEIGHT_HIERARCHY=0.25

# ----- delay prediction (Phase 7) -------------------------------------------
# Fitted model artefacts, one file per version. Old versions are kept so a
# stored prediction can always be traced to the model that produced it.
ML_MODEL_DIR=storage/models

# Floors below which training REFUSES rather than reporting an accuracy figure
# that would be noise. Counted in distinct completed activities, not rows.
# Until a model is promoted the rule-based rate forecast is used, and every
# prediction says which tier produced it.
ML_MIN_TRAINING_SAMPLES=40
ML_MIN_MINORITY_SAMPLES=8

# Out-of-fold ROC AUC a model must clear to be promoted. 0.5 is a coin flip.
ML_MIN_HELDOUT_ROC_AUC=0.60
# Stratified, activity-grouped cross-validation folds. Preferred over a single
# hold-out split: on a few dozen activities the reported figure would otherwise
# depend mostly on which rows landed in the split.
ML_CV_FOLDS=5
# How much the model must beat the rule-based forecast by, in ROC AUC, to be
# promoted. This is the guard a plain accuracy floor cannot provide: a
# homogeneous training set gives near-identical folds and a flattering score
# that no floor rejects, but the arithmetic scored on the same rows does.
# Set to 0 to promote on the accuracy floor alone -- not recommended.
ML_BASELINE_MARGIN=0.02

ML_N_ESTIMATORS=300
ML_MAX_DEPTH=8
ML_MIN_SAMPLES_LEAF=3
# Fixed so a reported metric is reproducible from the same rows.
ML_RANDOM_STATE=42

# Probability cut-offs for the risk bands shown to planners. Must increase.
ML_RISK_MEDIUM_THRESHOLD=0.35
ML_RISK_HIGH_THRESHOLD=0.60
ML_RISK_CRITICAL_THRESHOLD=0.80
