# Copy to .env and fill in. NEVER commit the real .env.

# ----- general --------------------------------------------------------------
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false

# ----- security -------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required in staging/production; auto-generated per-process if left blank locally.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- database -------------------------------------------------------------
# Inside docker-compose use POSTGRES_HOST=db ; running natively use localhost.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sih26122
# Optional single-URL override (wins over the parts above):
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
DB_ECHO=false

# ----- redis / background jobs ----------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ----- cors -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ----- storage --------------------------------------------------------------
UPLOAD_DIR=uploads
GENERATED_REPORTS_DIR=generated_reports
MAX_UPLOAD_SIZE_MB=50

# ----- pluggable providers (wired in later phases) --------------------------
LLM_PROVIDER=noop
EMBEDDING_PROVIDER=noop
OCR_PROVIDER=noop
